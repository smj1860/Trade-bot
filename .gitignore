# Rust
/rust-core/target/

# Python
python-strategy/.venv/
python-strategy/__pycache__/
python-strategy/strategy/__pycache__/
python-strategy/strategy/pb/__pycache__/
historical-data/__pycache__/
*.pyc

# Generated gRPC code — regenerate with generate_proto.sh rather than
# committing it, so proto changes can't silently drift from the checked-in
# generated files.
python-strategy/strategy/pb/*_pb2.py
python-strategy/strategy/pb/*_pb2_grpc.py
python-strategy/strategy/pb/*.pyi

# Never commit real credentials or a filled-in config
config/config.toml
python-strategy/strategy_config.toml
.env

# Run artifacts, not source
python-strategy/logs/
python-strategy/.pytest_cache/

# Trained model files (scripts/train_model.py's output) — regenerable from
# historical-data's Supabase tables, not source, and can get large; never
# committed. See docs/model-training.md for how to (re)produce one.
python-strategy/models/

# SQLite persistence store (positions/fills/orders) — a run artifact, and
# potentially sensitive (real order history), never something to commit.
rust-core/data/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# OS/editor cruft
.DS_Store
*.swp
